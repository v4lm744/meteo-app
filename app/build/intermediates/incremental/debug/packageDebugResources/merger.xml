/ic_settings.xml" qualifiers="" type="drawable"/><file name="ic_weather_placeholder" path="/workspace/github__v4lm744__meteo-app/app/src/main/res/drawable/ic_weather_placeholder.xml" qualifiers="" type="drawable"/><file name="ic_launcher" path="/workspace/github__v4lm744__meteo-app/app/src/main/res/mipmap-anydpi/ic_launcher.xml" qualifiers="anydpi-v4" type="mipmap"/><file name="ic_launcher_round" path="/workspace/github__v4lm744__meteo-app/app/src/main/res/mipmap-anydpi/ic_launcher_round.xml" qualifiers="anydpi-v4" type="mipmap"/><file name="backup_rules" path="/workspace/github__v4lm744__meteo-app/app/src/main/res/xml/backup_rules.xml" qualifiers="" type="xml"/><file name="data_extraction_rules" path="/workspace/github__v4lm744__meteo-app/app/src/main/res/xml/data_extraction_rules.xml" qualifiers="" type="xml"/><file name="weather_widget_info" path="/workspace/github__v4lm744__meteo-app/app/src/main/res/xml/weather_widget_info.xml" qualifiers="" type="xml"/><file name="network_security_config" path="/workspace/github__v4lm744__meteo-app/app/src/main/res/xml/network_security_config.xml" qualifiers="" type="xml"/><file name="weather_widget_info" path="/workspace/github__v4lm744__meteo-app/app/src/main/res/xml-v31/weather_widget_info.xml" qualifiers="v31" type="xml"/><file path="/workspace/github__v4lm744__meteo-app/app/src/main/res/values/colors.xml" qualifiers=""><color name="md_blue_deep">#1B3A5B</color><color name="md_blue_main">#2364AA</color><color name="md_blue_sky">#3DA9FC</color><color name="md_blue_light">#A5D8FF</color><color name="md_sun">#FFB703</color><color name="md_white">#FFFFFF</color><color name="md_text_dark">#1A1A2E</color><color name="md_card_overlay">#2EFFFFFF</color><color name="dialog_link">#2364AA</color></file><file path="/workspace/github__v4lm744__meteo-app/app/src/main/res/values/strings.xml" qualifiers=""><string name="app_name">Météo</string><string name="action_search">Rechercher une ville</string><string name="action_locate">Ma position</string><string name="action_api_key">Clé API</string><string name="action_about">À propos</string><string name="action_tutorial">Tutoriel clé API</string><string name="action_settings">Paramètres</string><string name="settings_sync_title">Synchronisation automatique des widgets</string><string name="settings_sync_interval_label">Fréquence de mise à jour</string><string name="settings_sync_disabled">Désactivée</string><plurals name="settings_sync_minutes">
        <item quantity="one">Toutes les %1$d minute</item>
        <item quantity="other">Toutes les %1$d minutes</item>
    </plurals><string name="settings_sync_hourly">Toutes les heures</string><string name="settings_sync_3h">Toutes les 3 heures</string><string name="settings_sync_hint">Les widgets d\'accueil affichent une météo plus récente grâce à une mise à jour régulière en arrière-plan, même quand l\'application est fermée.</string><string name="tutorial_title">Récupérer et configurer une clé API</string><string name="tutorial_intro">Cette application utilise l\'API gratuite d\'OpenWeatherMap pour afficher la météo. Suivez ces étapes pour obtenir une clé et la configurer.</string><string name="tutorial_step1_title">1. Créer un compte OpenWeatherMap</string><string name="tutorial_step1_text">Rendez-vous sur openweathermap.org et créez un compte gratuit (Sign In → Create an Account). Confirmez votre adresse e-mail via le lien reçu.</string><string name="tutorial_step2_title">2. Ouvrir la page des clés API</string><string name="tutorial_step2_text">Une fois connecté, ouvrez votre nom d\'utilisateur en haut à droite puis « My API keys », ou rendez-vous directement sur la page home.openweathermap.org/api_keys.</string><string name="tutorial_step3_title">3. Générer la clé</string><string name="tutorial_step3_text">Sur la page « My API keys », une clé est générée automatiquement (Default). Vous pouvez aussi en créer une nouvelle avec un nom. Copiez la chaîne de 32 caractères.</string><string name="tutorial_step4_title">4. Patienter pendant l\'activation</string><string name="tutorial_step4_text">Une nouvelle clé peut mettre jusqu\'à quelques heures (souvent 10 à 120 minutes) à s\'activer. Tant qu\'elle ne l\'est pas, l\'API renvoie « Invalid API key ».</string><string name="tutorial_step5_title">5. Saisir la clé dans l\'application</string><string name="tutorial_step5_text">Dans l\'application, ouvrez le menu (trois points en haut à droite) → « Clé API », collez la clé puis appuyez sur « Enregistrer ». La clé est stockée sur l\'appareil.</string><string name="tutorial_step6_title">6. Vérifier le plan gratuit</string><string name="tutorial_step6_text">Le plan « Free » (Current Weather, Forecast 5 days/3h, Geocoding) suffit pour l\'application. One Call API 3.0 n\'est pas utilisée ici. Vos 60 appels/min gratuits couvrent un usage personnel.</string><string name="tutorial_open_site">Ouvrir openweathermap.org</string><string name="tutorial_open_keys">Ouvrir la page des clés API</string><string name="action_save">Enregistrer</string><string name="action_get_key">Obtenir une clé</string><string name="hint_api_key">Clé API OpenWeatherMap</string><string name="api_key_hint">Clé stockée sur l’appareil. Obtenez une clé gratuite sur openweathermap.org.</string><string name="hint_city">Saisissez une ville…</string><string name="hourly_forecast">Prévisions par heure</string><string name="daily_forecast">Prévisions sur 7 jours</string><string name="region_map">Météo de la région</string><string name="sun_arc_title">Course du soleil</string><string name="feels_like">Ressenti</string><string name="humidity">Humidité</string><string name="wind">Vent</string><string name="pressure">Pression</string><string name="sunrise">Lever du soleil</string><string name="sunset">Coucher du soleil</string><string name="error_no_api_key">Clé API OpenWeather non configurée. Renseignez-la via le menu « Clé API ».</string><string name="error_generic">Une erreur est survenue. Vérifiez votre connexion.</string><string name="permission_required">Autorisation de localisation requise.</string><string name="loading">Chargement…</string><string name="retry">Réessayer</string><string name="hpa">%1$d hPa</string><string name="widget_configure_prompt">Choisissez une ville</string><string name="widget_title">Météo</string><string name="temperatures">Températures</string><string name="morning">Matin</string><string name="day_label">Jour</string><string name="evening">Soir</string><string name="night">Nuit</string><string name="conditions">Conditions</string><string name="rain_probability">Risque de pluie</string><string name="about_version_format">Version %1$s</string><string name="openweathermap_url">https://openweathermap.org</string><string name="about_data_source">Source des données</string><string name="about_data_source_text">Les données météorologiques sont fournies par OpenWeatherMap (service tiers). Conformément aux conditions d\'utilisation d\'OpenWeatherMap, l\'attribution « Données météo : OpenWeatherMap » est obligatoire. OpenWeatherMap n\'est pas responsable de l\'exactitude des prévisions affichées.</string><string name="about_map_source">Source des cartes</string><string name="about_map_source_text">Les fonds de carte proviennent d\'OpenStreetMap (OSM), des contributeurs OpenStreetMap sous licence Open Data Commons Open Database License (ODbL).</string><string name="about_privacy">Politique de confidentialité</string><string name="about_privacy_text">Cette application ne collecte aucune donnée personnelle et n\'utilise aucun service de pistage. La clé API OpenWeatherMap que vous saisissez est stockée uniquement sur votre appareil (elle n\'est jamais transmise hors de l\'appareil sauf pour interroger l\'API OpenWeatherMap). La position géographique n\'est utilisée que localement pour afficher la météo et n\'est jamais transmise ni enregistrée sur un serveur. Les recherches de ville et les coordonnées sont envoyées à l\'API OpenWeatherMap pour obtenir les prévisions.</string><string name="about_permissions">Permissions</string><string name="about_permissions_text">• Internet : récupérer les données météo auprès d\'OpenWeatherMap.
• État du réseau : vérifier la connectivité.
• Localisation (approximative/précise) : afficher la météo de votre position, uniquement à votre demande.</string><string name="about_oss">Licences open-source</string><string name="about_oss_text">Cette application est open-source et utilise des bibliothèques tierces : Retrofit, OkHttp, Moshi, Glide, osmdroid, Material Components for Android, AndroidX et les services Google Play. Chacune est diffusée sous sa propre licence open-source.</string><string name="about_licenses_link">Voir le code source et les licences</string><string name="about_publisher">Éditeur</string><string name="about_publisher_text">Application météo éditée à titre personnel. Le code source est disponible publiquement.</string><string name="about_contact">Contacter l\'éditeur</string><string name="cancel">Annuler</string><string name="today_short">Auj.</string><string name="no_result">Aucun résultat</string><string name="current_position">Position actuelle</string><string name="error_api_key_not_configured">Clé API non configurée</string><string name="error_api_key_invalid">Clé API invalide ou non encore activée</string><string name="error_api_key_invalid_short">Clé API invalide</string><string name="error_city_not_found_short">Ville introuvable</string><string name="error_server">Erreur serveur (%1$d)</string><string name="error_network">Vérifiez votre connexion internet</string><string name="cache_offline_banner">Données hors ligne — vérifiez votre connexion</string><string name="error_search">Erreur lors de la recherche</string><string name="error_region_cities">Erreur villes proches</string><string name="error_reverse_geocode">Erreur lors de la localisation</string><string name="error_location_permission">Autorisation de localisation requise</string><string name="error_location_unavailable">Position indisponible</string><string name="label_visibility">Visibilité</string><string name="hour_detail_title">Prévision par heure</string><string name="feels_like_short">Ressenti</string><string name="cloudiness">Nuages</string><string name="precipitation">Précipitations</string><string name="mm">%.1f mm</string><string name="splash_tagline">Votre météo, où que vous soyez</string><string name="settings_units_title">Unités et formats</string><string name="settings_units_hint">Choisissez les unités d\'affichage des mesures. Le changement est appliqué au prochain rafraîchissement de l\'écran.</string><string name="settings_unit_temp">Température</string><string name="settings_unit_temp_celsius">Celsius (°C)</string><string name="settings_unit_temp_fahrenheit">Fahrenheit (°F)</string><string name="settings_unit_wind">Vent</string><string name="settings_unit_wind_kmh">km/h</string><string name="settings_unit_wind_mph">mph</string><string name="settings_unit_pressure">Pression</string><string name="settings_unit_pressure_hpa">hPa</string><string name="settings_unit_pressure_inhg">inHg</string><string name="settings_unit_time">Format de l\'heure</string><string name="settings_unit_time_24h">24 h</string><string name="settings_unit_time_12h">12 h (AM/PM)</string><string name="inhg">%1$s inHg</string><string name="km">%1$d km</string><string name="miles">%1$d mi</string><string name="kmh_format">%1$s km/h</string><string name="mph_format">%1$s mph</string><string name="settings_unit_precision">Précision des valeurs</string><string name="settings_unit_precision_whole">Entier (17°, 36 km/h)</string><string name="settings_unit_precision_decimal">1 décimale (16,8°, 35,9 km/h)</string><string name="feels_like_value">Ressenti %1$s</string><string name="min_max_format">Max %1$s  Min %2$s</string><string name="format_percent">%1$d %%</string><string name="format_wind">%1$s %2$s</string></file><file path="/workspace/github__v4lm744__meteo-app/app/src/main/res/values/themes.xml" qualifiers=""><style name="Theme.MeteoApp.Splash" parent="Theme.Material3.DayNight.NoActionBar">
