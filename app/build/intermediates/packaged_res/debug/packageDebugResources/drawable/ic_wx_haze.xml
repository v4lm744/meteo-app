<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group android:name="cloudGroup">
                <path
                    android:name="cloud"
                    android:fillColor="#CFD8DC"
                    android:pathData="M7,15 C4.51,15 2.5,13.2 2.5,11 C2.5,8.8 4.51,7 7,7 C7.26,7 7.51,7.03 7.76,7.08 C8.55,5.47 10.2,4.36 12.12,4.36 C14.78,4.36 16.94,6.52 16.94,9.18 C16.94,9.29 16.94,9.4 16.93,9.51 C18.36,9.68 19.47,10.9 19.47,12.38 C19.47,13.98 18.17,15.27 16.57,15.27 L7,15.27 Z" />
