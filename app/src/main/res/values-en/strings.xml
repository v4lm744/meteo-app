    <string name="about_data_source">Data source</string>
    <string name="about_data_source_text">Weather data is provided by OpenWeatherMap (third-party service). Under OpenWeatherMap\'s terms of use, the attribution \u201cWeather data: OpenWeatherMap\u201d is mandatory. OpenWeatherMap is not responsible for the accuracy of the forecasts displayed.</string>
    <string name="about_map_source">Map source</string>
    <string name="about_map_source_text">Map tiles come from OpenStreetMap (OSM), OpenStreetMap contributors under the Open Data Commons Open Database License (ODbL).</string>
    <string name="about_privacy">Privacy policy</string>
    <string name="about_privacy_text">This app collects no personal data and uses no tracking service. The OpenWeatherMap API key you enter is stored only on your device (it is never sent off the device except to query the OpenWeatherMap API). Your location is only used locally to display the weather and is never transmitted or stored on a server. City searches and coordinates are sent to the OpenWeatherMap API to obtain forecasts.</string>
    <string name="about_permissions">Permissions</string>
    <string name="about_permissions_text">\u2022 Internet: fetch weather data from OpenWeatherMap.\n\u2022 Network state: check connectivity.\n\u2022 Location (coarse/fine): show the weather for your position, only at your request.</string>
    <string name="about_oss">Open-source licenses</string>
    <string name="about_oss_text">This app is open-source and uses third-party libraries: Retrofit, OkHttp, Moshi, Glide, osmdroid, Material Components for Android, AndroidX and Google Play services. Each is distributed under its own open-source license.</string>
