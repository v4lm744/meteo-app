<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:maxHeight="480dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/aboutAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_full_name"
            android:textColor="@color/md_text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aboutVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/md_text_dark"
            android:alpha="0.7"
            android:textSize="14sp"
            tools:text="Version 1.0" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/about_description"
            android:textColor="@color/md_text_dark"
            android:alpha="0.85"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:background="#1F1A1A2E" />

        <TextView style="@style/Widget.MeteoApp.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_data_source" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_data_source_text"
            android:textColor="@color/md_text_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutOpenWeatherLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/openweathermap_url"
            android:textColor="@color/dialog_link"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView style="@style/Widget.MeteoApp.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_map_source" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_map_source_text"
            android:textColor="@color/md_text_dark"
            android:textSize="14sp" />

        <TextView style="@style/Widget.MeteoApp.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_privacy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_privacy_text"
            android:textColor="@color/md_text_dark"
            android:textSize="14sp" />

        <TextView style="@style/Widget.MeteoApp.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_permissions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_permissions_text"
            android:textColor="@color/md_text_dark"
            android:textSize="14sp" />

        <TextView style="@style/Widget.MeteoApp.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_oss" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_oss_text"
            android:textColor="@color/md_text_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutLicensesLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_licenses_link"
            android:textColor="@color/dialog_link"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView style="@style/Widget.MeteoApp.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_publisher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_publisher_text"
            android:textColor="@color/md_text_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutContactLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_contact"
            android:textColor="@color/dialog_link"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
