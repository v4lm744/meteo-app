<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hourDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/hourDetailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/md_white"
        app:title="@string/hour_detail_title"
        app:titleTextColor="@color/md_white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/hourTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_white"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Lundi 14h" />

            <TextView
                android:id="@+id/hourDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.85"
                android:textColor="@color/md_white"
                android:textSize="15sp"
                tools:text="12 sept." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hourIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hourTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_white"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        tools:text="20°" />

                    <TextView
                        android:id="@+id/hourFeelsLike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:textColor="@color/md_white"
                        android:textSize="18sp"
                        tools:text="17°" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/hourDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:alpha="0.9"
                android:textAllCaps="true"
                android:textColor="@color/md_white"
                android:textSize="14sp"
                tools:text="Ciel dégagé" />

            <TextView
                style="@style/Widget.MeteoApp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/conditions" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MeteoApp.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.MeteoApp.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/feels_like_short" />

                        <TextView
                            android:id="@+id/feelsLikeValue"
                            style="@style/Widget.MeteoApp.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="17°" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.MeteoApp.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/humidity" />

                        <TextView
                            android:id="@+id/humidityValue"
                            style="@style/Widget.MeteoApp.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="65 %" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.MeteoApp.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wind" />

                        <TextView
                            android:id="@+id/windValue"
                            style="@style/Widget.MeteoApp.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="12 km/h" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.MeteoApp.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pressure" />

                        <TextView
                            android:id="@+id/pressureValue"
                            style="@style/Widget.MeteoApp.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="1013 hPa" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.MeteoApp.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rain_probability" />

                        <TextView
                            android:id="@+id/popValue"
                            style="@style/Widget.MeteoApp.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="30 %" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.MeteoApp.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cloudiness" />

                        <TextView
                            android:id="@+id/cloudinessValue"
                            style="@style/Widget.MeteoApp.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="10 %" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.MeteoApp.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/precipitation" />

                        <TextView
                            android:id="@+id/precipValue"
                            style="@style/Widget.MeteoApp.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="0.2 mm" />
                    </LinearLayout>
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
