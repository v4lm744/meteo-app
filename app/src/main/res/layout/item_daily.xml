<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/dayText"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:textColor="@color/md_white"
        android:textSize="15sp"
        tools:text="lun." />

    <ImageView
        android:id="@+id/dayIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        tools:src="@drawable/ic_weather_placeholder" />

    <TextView
        android:id="@+id/dayDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:alpha="0.85"
        android:textColor="@color/md_white"
        android:textSize="13sp"
        tools:text="Ciel dégagé" />

    <TextView
        android:id="@+id/dayPop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/md_blue_light"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="20%"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/dayMin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:alpha="0.7"
        android:textColor="@color/md_white"
        android:textSize="15sp"
        tools:text="12°" />

    <TextView
        android:id="@+id/dayMax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/md_white"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="20°" />
</LinearLayout>
