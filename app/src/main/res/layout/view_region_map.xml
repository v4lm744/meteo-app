<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.meteoapp.ui.map.ClickableMapView
        android:id="@+id/regionMap"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:clickable="true"
        android:focusable="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/radarToggle"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_gravity="center_horizontal"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/radar_toggle_off" />

    <TextView
        android:id="@+id/radarSourceNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:alpha="0.7"
        android:text="@string/radar_source_note"
        android:textColor="@color/md_text_dark"
        android:textSize="11sp"
        android:visibility="gone" />
</merge>
