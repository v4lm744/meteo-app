<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group android:name="moonGroup">
                <group android:name="moonPathGroup">
                    <path
                        android:name="moon"
                        android:fillColor="#FFF59D"
                        android:pathData="M14.5,3.2 C15.5,3.2 16.4,3.5 17.2,4 C13.9,4.6 11.4,7.5 11.4,11 C11.4,14.5 13.9,17.4 17.2,18 C16.4,18.5 15.5,18.8 14.5,18.8 C10.4,18.8 7,15.4 7,11 C7,6.6 10.4,3.2 14.5,3.2 Z" />
                </group>
                <path
                    android:name="star1"
                    android:fillColor="#FFF59D"
                    android:pathData="M19,8.4 L19.4,9.4 L20.4,9.8 L19.4,10.2 L19,11.2 L18.6,10.2 L17.6,9.8 L18.6,9.4 Z" />
                <path
                    android:name="star2"
                    android:fillColor="#FFF59D"
                    android:pathData="M20.4,13.6 L20.7,14.3 L21.4,14.6 L20.7,14.9 L20.4,15.6 L20.1,14.9 L19.4,14.6 L20.1,14.3 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="moonPathGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:duration="3000"
                android:repeatCount="-1"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                android:valueFrom="-0.4"
                android:valueTo="0.4"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="star1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:duration="1800"
                android:repeatCount="-1"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/linear_interpolator"
                android:valueFrom="0.3"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="star2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:duration="1800"
                android:startOffset="900"
                android:repeatCount="-1"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/linear_interpolator"
                android:valueFrom="1"
                android:valueTo="0.3"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
