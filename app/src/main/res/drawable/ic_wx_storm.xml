<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group android:name="cloudGroup">
                <path
                    android:name="cloud"
                    android:fillColor="#B0BEC5"
                    android:pathData="M7,13.5 C4.51,13.5 2.5,11.49 2.5,9 C2.5,6.51 4.51,4.5 7,4.5 C7.26,4.5 7.51,4.53 7.76,4.58 C8.55,2.97 10.2,1.86 12.12,1.86 C14.78,1.86 16.94,4.02 16.94,6.68 C16.94,6.79 16.94,6.9 16.93,7.01 C18.36,7.18 19.47,8.4 19.47,9.88 C19.47,11.48 18.17,12.77 16.57,12.77 L7,12.77 Z" />
            </group>
            <group android:name="bolt">
