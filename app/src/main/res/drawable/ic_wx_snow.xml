            </group>
        </vector>
    </aapt:attr>
    <target android:name="cloudGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:duration="3600"
                android:repeatCount="-1"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                android:valueFrom="-0.5"
                android:valueTo="0.5"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="flake1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:duration="1600"
                android:repeatCount="-1"
                android:interpolator="@android:anim/linear_interpolator"
                android:valueFrom="-1"
                android:valueTo="2.5"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="flake2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:duration="1600"
                android:startOffset="530"
                android:repeatCount="-1"
                android:interpolator="@android:anim/linear_interpolator"
                android:valueFrom="-1"
                android:valueTo="2.5"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="flake3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:duration="1600"
                android:startOffset="1060"
                android:repeatCount="-1"
                android:interpolator="@android:anim/linear_interpolator"
                android:valueFrom="-1"
                android:valueTo="2.5"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
